TELEGRAM_BOT_TOKEN=
# One key, or several comma-separated keys to rotate past a rate limit
# (e.g. aipipe's free tier caps at $0.1 / 7 days per token):
#   OPENAI_API_KEY=key_one,key_two,key_three
OPENAI_API_KEY=
OPENAI_BASE_URL=https://aipipe.org/openai/v1
AGENT_MODEL=gpt-5-mini

# Leave unset locally; Railway injects PORT and RAILWAY_PUBLIC_DOMAIN in production.
# PORT=8000
# PUBLIC_BASE_URL=

LOG_DIR=data/logs
STATE_PATH=data/state.json
REPLY_BUDGET=150
AGENT_MAX_STEPS=12
PY_TIMEOUT=90
PY_MAX_OUTPUT=6000
MAX_CONCURRENT_RUNS=4
HISTORY_MAX_MESSAGES=20
HISTORY_TTL_SECONDS=7200
POLL_TIMEOUT=50
LOG_LEVEL=INFO
